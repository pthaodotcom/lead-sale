{
  "name": "lead-sale",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "tsc --noEmit --project tsconfig.app.json && vite build",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:unit:app": "vitest run",
    "test:e2e": "playwright test --config playwright.lead.config.ts",
    "lint": "eslint src/components/lead-sale src/App.tsx src/main.tsx tests e2e/lead-sale e2e/cloud e2e/core scripts/lead-*.mjs scripts/serve.mjs scripts/generate-migration.mjs scripts/check-database.mjs",
    "format": "prettier --write src tests scripts *.ts *.json",
    "db:generate": "node scripts/generate-migration.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:apply": "node scripts/lead-apply.mjs",
    "db:migrate": "node scripts/lead-migrate.mjs",
    "dev:core": "node scripts/lead-core-server.mjs",
    "db:admin": "node scripts/lead-admin.mjs",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:e2e:core": "playwright test --config playwright.core.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.542.0",
    "papaparse": "^5.5.3",
    "ra-core": "^5.14.7",
    "ra-data-fakerest": "^5.10.0",
    "ra-i18n-polyglot": "^5.14.7",
    "ra-language-english": "^5.14.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.78.0",
    "react-router": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.19",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}

# Copy to .env.server.local. Never commit real server settings.
LEAD_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
# Download the project/Supabase root CA using the SSL settings and set its path.
LEAD_DB_CA_FILE=path/to/supabase-root.crt
# Only needed to provision the first administrator on your own project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
LEAD_ADMIN_EMAIL=admin@example.com
LEAD_ADMIN_PASSWORD=replace-with-your-own-password
LEAD_CORE_PORT=5180
LEAD_WEB_ORIGIN=http://127.0.0.1:5173
# Optional: leave unset to use a cryptographically random key for this process.
# LEAD_CORE_SOURCE_KEY=

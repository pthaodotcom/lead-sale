# Reference configuration for the original Atomic CRM edge functions.
# Lead Sale uses backend/supabase/ and does not require these settings.
# Copy to .env only when running the original reference application.
POSTMARK_WEBHOOK_USER=your-webhook-user
POSTMARK_WEBHOOK_PASSWORD=your-webhook-password
VITE_INBOUND_EMAIL=your-inbound-address@example.com
POSTMARK_WEBHOOK_AUTHORIZED_IPS=
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SB_PUBLISHABLE_KEY=your-publishable-key
CRM_BASE_URL=http://localhost:5173
